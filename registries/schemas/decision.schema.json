{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.schema.json",
  "title": "Decision",
  "type": "object",
  "additionalProperties": true,
  "required": ["decision_id", "recorded_at", "decision", "estado", "source_ref"],
  "properties": {
    "decision_id": { "type": "string", "pattern": "^DEC-" },
    "recorded_at": { "type": "string", "minLength": 1 },
    "owner": { "type": "string" },
    "decision": { "type": "string", "minLength": 1 },
    "estado": { "type": "string", "minLength": 1 },
    "source_ref": { "type": "string", "minLength": 1 }
  }
}
